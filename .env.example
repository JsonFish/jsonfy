# Nest API address used by Next.js server components.
NEST_API_URL=http://localhost:3001

# If browser-side API calls are added later, use the same value.
NEXT_PUBLIC_API_URL=http://localhost:3001

# Generate a secret with: npx auth secret
AUTH_SECRET=

# Public origin for self-hosted deployments behind a reverse proxy.
# Set this to the URL users open in their browser, without a trailing slash.
# AUTH_URL=https://example.com

# GitHub OAuth app callback: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Google OAuth web client callback: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
